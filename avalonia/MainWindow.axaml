<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScribbleAvalonia"
        mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="700"
        x:Class="ScribbleAvalonia.MainWindow"
        Title="Scribble — Avalonia"
        Width="940" Height="700"
        MinWidth="600" MinHeight="400"
        Background="#f5f5f7">
    <Grid RowDefinitions="Auto,Auto,*" Margin="16">
        <TextBlock Grid.Row="0" Text="Scribble — Avalonia (C# / .NET)"
                   FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12,8"
                BoxShadow="0 1 2 0 #20000000"
                HorizontalAlignment="Center"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="Color" VerticalAlignment="Center"/>
                <ComboBox x:Name="ColorBox" SelectedIndex="0" Width="130">
                    <ComboBoxItem Tag="#111111" Content="Black"/>
                    <ComboBoxItem Tag="#d40000" Content="Red"/>
                    <ComboBoxItem Tag="#0066cc" Content="Blue"/>
                    <ComboBoxItem Tag="#198754" Content="Green"/>
                    <ComboBoxItem Tag="#b85c00" Content="Orange"/>
                    <ComboBoxItem Tag="#6f42c1" Content="Purple"/>
                </ComboBox>
                <TextBlock Text="Size" VerticalAlignment="Center"/>
                <Slider x:Name="SizeSlider" Width="180" Minimum="1" Maximum="40" Value="3"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="SizeReadout" VerticalAlignment="Center" Width="28"/>
                <Button x:Name="ClearButton" Content="Clear"
                        Background="#111" Foreground="White"
                        Padding="14,6" CornerRadius="6"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" CornerRadius="8" ClipToBounds="True"
                BoxShadow="0 1 3 0 #20000000">
            <local:ScribbleCanvas x:Name="Surface" Cursor="Cross"/>
        </Border>
    </Grid>
</Window>
